# /etc/systemd/system/nova-backend.service
# Starts the NestJS backend at boot and restarts it if it crashes.
[Unit]
Description=Nova Habitation et Piscine - backend NestJS
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=nova
WorkingDirectory=/opt/nova-habitation-backend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
